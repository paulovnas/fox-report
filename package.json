{
  "name": "@foxtag/fox-report",
  "version": "0.2.0",
  "description": "Relato de bugs com captura de tela e contexto, integrado ao Monday. Widget universal para web e handler server-side.",
  "keywords": [
    "bug-report",
    "feedback",
    "screenshot",
    "widget",
    "monday",
    "qa"
  ],
  "license": "MIT",
  "author": "paulovnas",
  "homepage": "https://github.com/paulovnas/fox-report#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulovnas/fox-report.git"
  },
  "bugs": {
    "url": "https://github.com/paulovnas/fox-report/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/fox-report.mjs",
  "module": "./dist/fox-report.mjs",
  "types": "./dist/types/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/client/index.d.ts",
      "import": "./dist/fox-report.mjs"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "import": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node test/integration.monday.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "html-to-image": "1.11.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
